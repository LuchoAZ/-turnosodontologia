# Gestion Odontologica PyME — environment template.
# Copy to `.env` for local development. NEVER commit real values.
# Source of truth: knowledge-base/08_arquitectura_propuesta.md (Variables de entorno).

# --- Runtime ---
ENVIRONMENT=local
SERVICE_NAME=odontologia-saas-api
DEFAULT_TENANT_TIMEZONE=America/Argentina/Buenos_Aires
APPLY_TO_ALL_ORIGINS=http://localhost:5173

# --- Data stores ---
DATABASE_URL=postgresql://odontologia:odontologia@localhost:5432/odontologia
DIRECT_URL=postgresql://odontologia:odontologia@localhost:5432/odontologia
REDIS_URL=redis://localhost:6379/0

# --- Secrets (generate real random values; do not reuse these) ---
SESSION_SECRET=change-me-random-64-bytes
JWT_REFRESH_SECRET=change-me-random-64-bytes
KMS_MASTER_KEY_ID=

# --- ARCA (fiscal) ---
ARCA_WSDL_PROD_URL=https://wsaa.afip.gov.ar/ws/services/LoginCms
ARCA_WSDL_TEST_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
ARCA_CERT_STORE_PASSPHRASE=

# --- Communications ---
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
EMAIL_PROVIDER_API_KEY=

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Observability (OTEL / Sentry) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# --- Digital signature (v0.2) ---
SIGNING_PROVIDER_URL=
SIGNING_PROVIDER_KEY=
